pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_EXE = 'C:\\Users\\bomma\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_EXE = 'C:\\Users\\bomma\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
        MAVEN_EXE = 'C:\\Tools\\apache-maven\\bin\\mvn.cmd'
        PYTHON_EXE = 'C:\\Program Files\\Python314\\python.exe'
        KUBECONFIG = 'C:\\Users\\bomma\\.kube\\config'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test Backend') {
            steps {
                dir('agriconnect-backend') {
                    bat '"%MAVEN_EXE%" -B clean verify'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'agriconnect-backend/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Test Weather Service') {
            steps {
                dir('weather-service') {
                    bat '"%PYTHON_EXE%" -m venv .venv'
                    bat '.venv\\Scripts\\python.exe -m pip install --disable-pip-version-check -r requirements.txt'
                    bat '.venv\\Scripts\\python.exe -m pytest test_app.py -v'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('agriconnect-backend') {
                    bat '"%DOCKER_EXE%" build -t agriconnect-backend:%IMAGE_TAG% .'
                }

                dir('weather-service') {
                    bat '"%DOCKER_EXE%" build -t agriconnect-weather:%IMAGE_TAG% .'
                }

                dir('frontend') {
                    bat '"%DOCKER_EXE%" build -t agriconnect-frontend:%IMAGE_TAG% .'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '"%KUBECTL_EXE%" get secret agriconnect-secrets'
                bat '"%KUBECTL_EXE%" apply -f kubernetes\\configmap.yaml'

                bat '"%KUBECTL_EXE%" apply -f kubernetes\\backend-service.yaml'
                bat '"%KUBECTL_EXE%" apply -f kubernetes\\backend-deployment.yaml'

                bat '"%KUBECTL_EXE%" apply -f kubernetes\\weather-service.yaml'
                bat '"%KUBECTL_EXE%" apply -f kubernetes\\weather-deployment.yaml'

                bat '"%KUBECTL_EXE%" apply -f kubernetes\\frontend-service.yaml'
                bat '"%KUBECTL_EXE%" apply -f kubernetes\\frontend-deployment.yaml'

                bat '"%KUBECTL_EXE%" set image deployment/agriconnect-backend agriconnect-backend=agriconnect-backend:%IMAGE_TAG%'
                bat '"%KUBECTL_EXE%" set image deployment/agriconnect-weather agriconnect-weather=agriconnect-weather:%IMAGE_TAG%'
                bat '"%KUBECTL_EXE%" set image deployment/agriconnect-frontend frontend=agriconnect-frontend:%IMAGE_TAG%'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '"%KUBECTL_EXE%" rollout status deployment/agriconnect-backend --timeout=180s'
                bat '"%KUBECTL_EXE%" rollout status deployment/agriconnect-weather --timeout=120s'
                bat '"%KUBECTL_EXE%" rollout status deployment/agriconnect-frontend --timeout=120s'

                bat '"%KUBECTL_EXE%" get deployments'
                bat '"%KUBECTL_EXE%" get pods'
                bat '"%KUBECTL_EXE%" get services'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: AgriConnect CI/CD pipeline completed!'
        }

        failure {
            echo 'FAILURE: Check the pipeline logs.'
            bat '"%KUBECTL_EXE%" get pods -A'
        }

        always {
            echo "Build ${env.BUILD_NUMBER} finished."
            cleanWs()
        }
    }
}